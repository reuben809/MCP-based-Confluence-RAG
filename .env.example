# ============================================
# Augmented Skeleton Navigator - Environment
# ============================================
# Copy this file to .env and configure for your Confluence instance

# ============================================
# REQUIRED: Confluence Configuration
# ============================================

# Your Confluence instance URL (no trailing slash)
# Examples:
#   Atlassian Cloud: https://your-org.atlassian.net/wiki
#   Confluence Server: https://confluence.yourcompany.com
#   Public Wiki: https://wiki.example.org/confluence
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki

# Confluence space key to index (found in the URL: /spaces/MYSPACE/...)
CONFLUENCE_SPACE_KEY=MYSPACE

# Personal Access Token for authentication
# - For Atlassian Cloud: Generate at https://id.atlassian.com/manage-profile/security/api-tokens
# - For Confluence Server: Generate in Profile > Personal Access Tokens
# - For anonymous access (public wiki): use "anonymous"
CONFLUENCE_PAT=your_personal_access_token

# ============================================
# OPTIONAL: Qdrant Configuration
# ============================================

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=skeleton_vectors

# ============================================
# OPTIONAL: Local Models Path
# ============================================

FASTEMBED_CACHE_PATH=./models_cache

# ============================================
# OPTIONAL: MCP Server
# ============================================

MCP_SSE_HOST=0.0.0.0
MCP_SSE_PORT=8080

# ============================================
# OPTIONAL: Search Parameters
# ============================================

SEARCH_TOP_K=5
SEARCH_FETCH_MULTIPLIER=4
MAX_CONTENT_CHARS=12000

# ============================================
# OPTIONAL: Ingestion Parameters
# ============================================

INGESTION_BATCH_SIZE=64
INGESTION_MAX_PAGES=2000

# ============================================
# OPTIONAL: LLM for chat features
# ============================================

LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model
